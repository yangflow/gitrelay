{
  "sourceLanguage": "en",
  "strings": {
    "NSFocusStatusUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitRelay defers sync failure notifications while Focus is on, then sends a combined summary when Focus ends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitRelay 会在专注模式开启时推迟同步失败通知，并在专注结束后发送聚合摘要。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitRelay uses Touch ID or your login password to protect sensitive actions such as viewing tokens and deleting repositories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitRelay 使用 Touch ID 或登录密码来保护查看令牌和删除仓库等敏感操作。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
