          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需本机已安装 cloudflared。示例：cloudflared tunnel --url http://127.0.0.1:<port>，再把生成的 https 主机填入公共 Base URL。"
