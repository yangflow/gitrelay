    "A shallow clone cannot perform a complete push --mirror. Only the selected refs will sync, so this is not a complete backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shallow clone cannot perform a complete push --mirror. Only the selected refs will sync, so this is not a complete backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅克隆无法完整 push --mirror，将仅同步所选 ref，不构成完整备份。"
          }
        }
      }
    },
    "A source repository can be mirrored to multiple targets. Choose a Git remote or filesystem archive (tar.gz, zip, or git bundle). Disabled targets are skipped during sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source repository can be mirrored to multiple targets. Choose a Git remote or filesystem archive (tar.gz, zip, or git bundle). Disabled targets are skipped during sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一源仓库可镜像到多个目标；可选择 Git 远程或文件系统归档 (tar.gz / zip / git bundle)。禁用的目标在同步时跳过。"
          }
        }
      }
    },
