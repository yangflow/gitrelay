    "A future Cloudflare Worker or GitHub App could relay to this Mac using long polling. This version provides configuration only and does not deploy hosted infrastructure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A future Cloudflare Worker or GitHub App could relay to this Mac using long polling. This version provides configuration only and does not deploy hosted infrastructure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来可由 Cloudflare Worker / GitHub App 长轮询中继到本机；本版本仅保留配置入口，不部署托管基础设施。"
          }
        }
      }
    },
    "A key file already exists at: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key file already exists at: %@"
