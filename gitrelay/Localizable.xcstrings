    "Periodically compare subscribed GitHub organizations or GitLab groups against locally mirrored repositories. When new repos appear, GitRelay can notify you or auto-add them using a preset template.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodically compare subscribed GitHub organizations or GitLab groups against locally mirrored repositories. When new repos appear, GitRelay can notify you or auto-add them using a preset template."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定期将已订阅的 GitHub 组织或 GitLab 群组与本地已镜像仓库对比。出现新仓库时，GitRelay 可通知您，或使用预设模板自动添加。"
          }
        }
      }
    },
    "Periodically compare the src/dst tip SHA and tree hash for a random sample of repositories. Mismatches are marked as content divergence.": {
