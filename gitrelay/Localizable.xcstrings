          }
        }
      }
    },
    "Within a single sync, retry fetch/clone/push (and LFS) on brief network errors using 2s / 8s / 32s backoff. Total wait is capped at 3 minutes. Auth failures and local corruption are not retried.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within a single sync, retry fetch/clone/push (and LFS) on brief network errors using 2s / 8s / 32s backoff. Total wait is capped at 3 minutes. Auth failures and local corruption are not retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次同步内，对短暂网络错误按 2 秒 / 8 秒 / 32 秒退避重试 fetch/clone/push（以及 LFS）。总等待不超过 3 分钟。认证失败与本地仓库损坏不会重试。"
          }
        }
      }
    },
    "You can push to check branches under %@ first and leave the target's own branches where they are.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can push to check branches under %@ first and leave the target's own branches where they are."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先推到 %@ 下的检查分支，目标仓原有分支保持不动。"
          }
        }
      }
    },
