          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步 git 仓库后，将源仓库 Release 的 tag/title/body 与 .dmg、.tar.gz 等附件增量复制到每个已启用目标。需要 GitHub/GitLab API Token。"
