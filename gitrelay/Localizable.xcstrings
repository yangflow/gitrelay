          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到校验通过的 push 事件后立即同步，不受频率调度限制。需在「设置 → Webhook」启用本机监听；外网暴露使用 Cloudflare Tunnel / Tailscale Funnel（可选）。"
          }
        }
      }
    },
